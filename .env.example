# Copy to `.env` and fill in. Never commit `.env`.
# Local development: the API container (compose) sets DATABASE_URL itself via
# postgres:5432; this one is used by the host Prisma CLI and by `npm run build`.
DATABASE_URL=postgresql://taskforge:taskforge@127.0.0.1:5432/taskforge?schema=public

# Integration tests: Jest pins DATABASE_URL/TEST_DATABASE_URL to a *_test
# database automatically (tests/test-env.ts). Override only to point at another
# isolated test database — never the dev/production one.
# TEST_DATABASE_URL=postgresql://taskforge:taskforge@127.0.0.1:5432/taskforge_test?schema=public